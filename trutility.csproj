<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFramework>net462-windows</TargetFramework>
    <LangVersion>latestMajor</LangVersion>

    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>

    <Product>trutility</Product>
    <Copyright>© 2026 Vladimir Kuznetsov</Copyright>

    <AssemblyName>trutility</AssemblyName>
    <AssemblyTitle>trutility</AssemblyTitle>
    
    <RootNamespace>trutility</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <!-- VERSIONING -->
    <Version>2.4.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- BUILD -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>

    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

  <!-- Shown in the About tab; BuildLogo looks it up by this name. -->
  <ItemGroup>
    <EmbeddedResource Include="packaging\Assets\trutility_1024x1024.png" LogicalName="trutility.logo.png" />
  </ItemGroup>

  <!-- The test project sits below this one, so keep its files out of the exe. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <InternalsVisibleTo Include="trutility.Tests" />
  </ItemGroup>

</Project>
